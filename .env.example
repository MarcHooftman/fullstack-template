
# Copy this file to `.env` and adjust values as needed for your environment.

### Backend (Api) ###
# Kestrel binding and environment
ASPNETCORE_URLS=http://0.0.0.0:80
ASPNETCORE_ENVIRONMENT=Development

# URL of the issuer service used by the API when validating/issuing tokens
ISSUER_URL=http://issuer:80

# Connection string for the primary database (Postgres)
# Format used by the app: Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<pass>
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=db;Username=user;Password=pass


### Database (Postgres) ###
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=db


### Issuer (Api.JWT) ###
# Kestrel binding and environment for the issuer service
ISSUER_ASPNETCORE_URLS=http://0.0.0.0:80
ISSUER_ASPNETCORE_ENVIRONMENT=Development
# Connection string for the JWT issuer service (Postgres). Used by Api.Jwt via
# `ConnectionStrings:JwtConnection` or the fallback `JWT_CONNECTION` env var.
# Format: Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<pass>
ConnectionStrings__JwtConnection=Host=db;Port=5432;Database=jwt_db;Username=user;Password=pass
JWT_CONNECTION=Host=db;Port=5432;Database=jwt_db;Username=user;Password=pass
### Jwt signing key (replace in production) ###
# The configuration key is `Jwt:Key` (use environment variable `Jwt__Key` in Docker)
Jwt__Key=supersecret_dev_key
Jwt__Issuer=Issuer
Jwt__Audience=Audience


### Frontend ###
# Node environment and API base URL used by Next.js (client-side)
NODE_ENV=production
NEXT_PUBLIC_API_BASE_URL=http://backend:80


### PgAdmin ###
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=admin

# Notes:
# - The docker-compose file maps these values to service containers (e.g. `backend`, `db`, `frontend`).
# - When running services locally outside Docker, you may want to change `NEXT_PUBLIC_API_BASE_URL` to `http://localhost:8080` (or whichever port your API listens on).
# - Keep secrets (passwords, connection strings, signing keys) out of source control for real deployments.
